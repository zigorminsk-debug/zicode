{
  "manifest_version": 3,
  "name": "ZiCode (OpenCode) — Chrome Browser Bridge",
  "version": "2.3.0",
  "description": "Позволяет программе ZiCode (OpenCode для Windows и Android) видеть и читать ваши открытые вкладки и веб-страницы в Google Chrome.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZiCode Browser Bridge (OpenCode)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
