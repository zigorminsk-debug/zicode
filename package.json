{
  "name": "zicode",
  "version": "2.7.0",
  "description": "ZiCode — Full-featured OpenCode AI Coding Agent for Android and Windows with 100% OpenCode free models & functionality",
  "main": "electron/main.cjs",
  "author": "ZiCode Open Source (OpenCode Compatible)",
  "license": "MIT",
  "scripts": {
    "dev": "node server/dev-runner.cjs",
    "start": "node server/index.cjs",
    "build:web": "vite build",
    "sync:android": "node scripts/sync-android-assets.cjs",
    "build": "vite build && node scripts/sync-android-assets.cjs",
    "electron:dev": "electron .",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "test": "node scripts/self-test.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "ai.zicode.opencode",
    "productName": "ZiCode",
    "npmRebuild": false,
    "directories": {
      "output": "release-builds"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZiCode (OpenCode)",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
